# ---------------------------------------------------------------------------
# Moon math: a port of SunCalc's getMoonIllumination (the library the site
# loads from its CDN), so the widget and asciimoon.com always agree.
# ---------------------------------------------------------------------------

RAD = math.pi / 180
DAY_S = 86400
J1970 = 2440588
J2000 = 2451545
OBLIQUITY = RAD * 23.4397


def _to_days(when):
    return when.timestamp() / DAY_S - 0.5 + J1970 - J2000


def _right_ascension(l, b):
    return math.atan2(math.sin(l) * math.cos(OBLIQUITY) - math.tan(b) * math.sin(OBLIQUITY), math.cos(l))


def _declination(l, b):
    return math.asin(math.sin(b) * math.cos(OBLIQUITY) + math.cos(b) * math.sin(OBLIQUITY) * math.sin(l))


def _sun_coords(d):
    m = RAD * (357.5291 + 0.98560028 * d)
    c = RAD * (1.9148 * math.sin(m) + 0.02 * math.sin(2 * m) + 0.0003 * math.sin(3 * m))
    l = m + c + RAD * 102.9372 + math.pi
    return _declination(l, 0), _right_ascension(l, 0)


def _moon_coords(d):
    lon = RAD * (218.316 + 13.176396 * d)
    anomaly = RAD * (134.963 + 13.064993 * d)
    f = RAD * (93.272 + 13.229350 * d)
    l = lon + RAD * 6.289 * math.sin(anomaly)
    b = RAD * 5.128 * math.sin(f)
    dist = 385001 - 20905 * math.cos(anomaly)
    return _declination(l, b), _right_ascension(l, b), dist


def moon_illumination(when):
    """Return (fraction lit 0..1, phase 0..1) exactly like SunCalc."""
    d = _to_days(when)
    s_dec, s_ra = _sun_coords(d)
    m_dec, m_ra, m_dist = _moon_coords(d)
    sun_dist = 149598000
    phi = math.acos(math.sin(s_dec) * math.sin(m_dec) + math.cos(s_dec) * math.cos(m_dec) * math.cos(s_ra - m_ra))
    inc = math.atan2(sun_dist * math.sin(phi), m_dist - sun_dist * math.cos(phi))
    angle = math.atan2(
        math.cos(s_dec) * math.sin(s_ra - m_ra),
        math.sin(s_dec) * math.cos(m_dec) - math.cos(s_dec) * math.sin(m_dec) * math.cos(s_ra - m_ra),
    )
    fraction = (1 + math.cos(inc)) / 2
    phase = 0.5 + 0.5 * inc * (-1 if angle < 0 else 1) / math.pi
    return fraction, phase


# Same thresholds as ASCIIMoon.astro's getMoonPhaseName.
PHASES = [
    (0.03, "New Moon", "🌑"),
    (0.22, "Waxing Crescent", "🌒"),
    (0.28, "First Quarter", "🌓"),
    (0.48, "Waxing Gibbous", "🌔"),
    (0.52, "Full Moon", "🌕"),
    (0.72, "Waning Gibbous", "🌖"),
    (0.78, "Last Quarter", "🌗"),
    (0.97, "Waning Crescent", "🌘"),
    (1.01, "New Moon", "🌑"),
]
SOUTH_EMOJI = {"🌒": "🌘", "🌓": "🌗", "🌔": "🌖", "🌖": "🌔", "🌗": "🌓", "🌘": "🌒"}


def phase_name(phase, south=False):
    for limit, name, emoji in PHASES:
        if phase < limit:
            return name, SOUTH_EMOJI.get(emoji, emoji) if south else emoji
    return "New Moon", "🌑"


def next_events(when):
    """Hours until the next full and new moon (1 hour resolution)."""
    full = new = None
    _, prev = moon_illumination(when)
    for h in range(1, 24 * 31):
        _, cur = moon_illumination(when + dt.timedelta(hours=h))
        if full is None and prev < 0.5 <= cur:
            full = h
        if new is None and cur < prev:
            new = h
        if full is not None and new is not None:
            break
        prev = cur
    return full, new


def fmt_hours(h):
    if h is None:
        return "?"
    return f"{h // 24}d {h % 24}h" if h >= 24 else f"{h}h"


