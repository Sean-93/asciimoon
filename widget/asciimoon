# Output
# ---------------------------------------------------------------------------


def parse_hex(value):
    v = value.lstrip("#")
    if len(v) == 3:
        v = "".join(c * 2 for c in v)
    try:
        return tuple(int(v[i : i + 2], 16) for i in (0, 2, 4))
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a hex colour: {value}")


def _mix(a, b, t):
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def cell_colour(ink, light, lit, shadow):
    bright = _mix(shadow, lit, 0.45 + 0.55 * ink)  # denser glyphs glow brighter
    return _mix(shadow, bright, light)


def ansi_moon(cells, args):
    lines = []
    for row in cells:
        parts, last = [], None
        for char, ink, light in row:
            if args.hide_shadow and light < 0.5:
                char = " "
            if not args.color or char == " ":
                parts.append(char)
                continue
            rgb = cell_colour(ink, light, args.moon_color, args.shadow_color)
            if rgb != last:
                parts.append("\x1b[38;2;%d;%d;%dm" % rgb)
                last = rgb
            parts.append(char)
        lines.append("".join(parts).rstrip() + ("\x1b[0m" if args.color else ""))
    return lines


def info_lines(when, fraction, phase, args):
    name, emoji = phase_name(phase, args.south)
    full, new = next_events(when)
    return [
        f"{emoji} {name}",
        f"{fraction * 100:.2f}% moonlight · {when.strftime('%Y-%m-%d')}",
        f"full in {fmt_hours(full)} · new in {fmt_hours(new)}",
    ]


def waybar(when, args):
    fraction, phase = moon_illumination(when)
    name, emoji = phase_name(phase, args.south)
    full, new = next_events(when)
    cells = render_cells(args.tooltip_width, fraction, phase, args.cell_aspect, args.south)
    art = []
    for row in cells:
        spans = []
        for char, ink, light in row:
            if args.hide_shadow and light < 0.5:
                char = " "
            if char == " ":
                spans.append(" ")
            else:
                rgb = cell_colour(ink, light, args.moon_color, args.shadow_color)
                spans.append('<span color="#%02x%02x%02x">%s</span>' % (*rgb, html.escape(char)))
        art.append("".join(spans))
    tooltip = (
        "<tt>" + "\n".join(art) + "</tt>\n\n"
        f"<b>{name}</b>\n{fraction * 100:.2f}% moonlight\n"
        f"full moon in {fmt_hours(full)}\nnew moon in {fmt_hours(new)}"
    )
    print(json.dumps({
        "text": f"{emoji} {fraction * 100:.0f}%",
        "alt": name.lower().replace(" ", "-"),
        "tooltip": tooltip,
        "class": name.lower().replace(" ", "-"),
        "percentage": round(fraction * 100),
    }, ensure_ascii=False))


def frame(when, args, cols, rows):
    """Build a full frame of lines, sized and centred for a cols x rows area."""
    fraction, phase = moon_illumination(when)
    info = [] if args.no_info else info_lines(when, fraction, phase, args)
    gap = 1 if info else 0
    width = args.width
    if not width:
        room = rows - len(info) - gap
        width = max(8, min(cols - 2, int(room * args.cell_aspect)))
        if not args.watch:
            width = min(width, 60)
    moon = ansi_moon(render_cells(width, fraction, phase, args.cell_aspect, args.south), args)
    pad = " " * max(0, (cols - width) // 2)
    lines = [pad + l for l in moon]
    if info:
        lines.append("")
        accent = "\x1b[38;2;%d;%d;%dm" % args.moon_color if args.color else ""
        reset = "\x1b[0m" if args.color else ""
        for l in info:
            lines.append(" " * max(0, (cols - len(l)) // 2) + accent + l + reset)
    top = max(0, (rows - len(lines)) // 2) if args.watch else 0
    return [""] * top + lines


def watch(args):
    fd = sys.stdin.fileno() if sys.stdin.isatty() else None
    old_tty = None
    if fd is not None:
        import termios
        import tty

        old_tty = termios.tcgetattr(fd)
        tty.setcbreak(fd)
    offset = dt.timedelta()
    animate = args.animate
    dirty = True
    signal.signal(signal.SIGWINCH, lambda *_: None)
    sys.stdout.write("\x1b[?1049h\x1b[?25l")  # alt screen, hide cursor
    try:
        last_draw = 0.0
        while True:
            now = time.monotonic()
            if animate:
                offset += dt.timedelta(hours=8)
                dirty = True
            if dirty or now - last_draw >= args.interval:
                cols, rows = shutil.get_terminal_size()
                when = dt.datetime.now().astimezone() + offset
                out = frame(when, args, cols, rows)
                sys.stdout.write("\x1b[H\x1b[2J" + "\n".join(out[:rows]))
                sys.stdout.flush()
                last_draw, dirty = now, False
            timeout = 0.06 if animate else max(0.1, args.interval - (time.monotonic() - last_draw))
            try:
                ready = select.select([fd] if fd is not None else [], [], [], timeout)[0]
            except InterruptedError:
                ready = []
                dirty = True  # SIGWINCH: terminal resized
            if not ready:
                continue
            key = os.read(fd, 16).decode(errors="ignore")
            if key in ("q", "\x1b"):
                break
            elif key in ("h", "\x1b[D"):
                offset -= dt.timedelta(days=1)
            elif key in ("l", "\x1b[C"):
                offset += dt.timedelta(days=1)
            elif key == "t":
                offset, animate = dt.timedelta(), False
            elif key == " ":
                animate = not animate
            dirty = True
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\x1b[0m\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()
        if old_tty is not None:
            import termios

            termios.tcsetattr(fd, termios.TCSADRAIN, old_tty)


def main():
    p = argparse.ArgumentParser(description="The ASCIIMoon, as a terminal / Hyprland widget.")
    p.add_argument("-w", "--watch", action="store_true", help="live, centred, auto-refreshing widget")
    p.add_argument("--waybar", action="store_true", help="print JSON for a Waybar custom module")
    p.add_argument("-W", "--width", type=int, default=0, help="moon width in columns (default: fit terminal)")
    p.add_argument("-d", "--date", help="show another day, YYYY-MM-DD")
    p.add_argument("-i", "--interval", type=float, default=600, help="watch refresh seconds (default 600)")
    p.add_argument("--animate", action="store_true", help="start --watch cycling through the month")
    p.add_argument("--moon-color", type=parse_hex, default=parse_hex(os.environ.get("ASCIIMOON_COLOR", "#00ffff")),
                   help="lit colour, hex (default aqua like the site; env ASCIIMOON_COLOR)")
    p.add_argument("--shadow-color", type=parse_hex,
                   default=parse_hex(os.environ.get("ASCIIMOON_SHADOW", "#16302f")),
                   help="shadow colour, hex (env ASCIIMOON_SHADOW)")
    p.add_argument("--hide-shadow", action="store_true", help="blank the dark side instead of dimming it")
    p.add_argument("--south", action="store_true", help="southern hemisphere view (mirrored)")
    p.add_argument("--no-info", action="store_true", help="moon only, no text")
    p.add_argument("--no-color", dest="color", action="store_false", help="plain text output")
    p.add_argument("--cell-aspect", type=float, default=2.1, help="terminal cell height/width ratio (default 2.1)")
    p.add_argument("--tooltip-width", type=int, default=36, help="waybar tooltip moon width (default 36)")
    args = p.parse_args()

    if os.environ.get("NO_COLOR") or (not args.watch and not args.waybar and not sys.stdout.isatty()):
        args.color = args.color and bool(os.environ.get("FORCE_COLOR"))

    when = dt.datetime.now().astimezone()
    if args.date:
        day = dt.date.fromisoformat(args.date)
        when = when.replace(year=day.year, month=day.month, day=day.day)

    if args.waybar:
        waybar(when, args)
    elif args.watch:
        if args.date:
            p.error("--date can't be combined with --watch (use h/l inside the widget)")
        watch(args)
    else:
        cols, rows = shutil.get_terminal_size()
        print("\n".join(frame(when, args, cols, rows)))


if __name__ == "__main__":
    main()
