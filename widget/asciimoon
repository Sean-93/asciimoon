RAMP = " .,*/(#%&@"  # light -> heavy, the characters the original art uses
INK = {c: i / (len(RAMP) - 1) for i, c in enumerate(RAMP)}


def _load_art():
    lines = [l.rstrip() for l in MOON_ART.split("\n")]
    rows = [i for i, l in enumerate(lines) if l.strip()]
    lines = lines[rows[0] : rows[-1] + 1]
    left = min(len(l) - len(l.lstrip()) for l in lines if l.strip())
    width = max(len(l) for l in lines) - left
    return [[INK.get(c, 0.0) for c in l[left:].ljust(width)] for l in lines]


ART = _load_art()


def render_cells(width, fraction, phase, cell_aspect=2.1, south=False, soft=0.06):
    """Downsample the art to `width` columns and compute per-cell light.

    Returns rows of (char, ink 0..1, light 0..1). `light` is 1 on the sunlit
    part of the disc and 0 in shadow, with a soft band at the terminator.
    """
    src_h, src_w = len(ART), len(ART[0])
    height = max(3, round(width / cell_aspect))
    waxing = phase < 0.5
    if south:
        waxing = not waxing
    # Terminator is an ellipse: x = k * sqrt(1 - y^2), k = 1 (new) .. -1 (full).
    k = 1 - 2 * fraction
    out = []
    for i in range(height):
        r0, r1 = i * src_h // height, max((i + 1) * src_h // height, i * src_h // height + 1)
        y = (i + 0.5) / height * 2 - 1
        half = math.sqrt(max(0.0, 1 - y * y))
        row = []
        for j in range(width):
            c0, c1 = j * src_w // width, max((j + 1) * src_w // width, j * src_w // width + 1)
            block = [v for r in ART[r0:r1] for v in r[c0:c1]]
            ink = sum(block) / len(block)
            char = RAMP[round(ink * (len(RAMP) - 1))]
            x = (j + 0.5) / width * 2 - 1
            edge = x - k * half if waxing else -k * half - x
            light = min(1.0, max(0.0, edge / soft + 0.5)) if half > 0 else 0.0
            row.append((char, ink, light))
        out.append(row)
    return out


