#!/usr/bin/env python3
"""asciimoon - the ASCIIMoon site as a terminal / Hyprland rice widget.

Renders the Galileo moon ASCII art from asciimoon.com in your terminal, with
the moon's current phase shaded in. Pure Python standard library, one file.

  asciimoon                 print today's moon once
  asciimoon --watch         live widget (h/l or arrows: day, t: today,
                            space: animate a lunar month, q: quit)
  asciimoon --waybar        JSON for a Waybar custom module
  asciimoon --help          all options
"""

